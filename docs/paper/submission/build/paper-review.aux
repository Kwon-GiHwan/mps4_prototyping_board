\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distribution of the reversal across the frozen 14-group common attribution partition. The \textbf  {whole-model observed delta is +19,000} cycles (Section\nonbreakingspace \ref {sec:7.1}); the \textbf  {reconstructed profiled-group delta is +19,060}, and the \textbf  {60-cycle residual} is the deterministic profiling-boundary (interrupt-service) residual described in Section\nonbreakingspace \ref {sec:9.5} --- the two measurement boundaries are not identical and the figure does not treat them as one. No group is claimed as the cause of the whole-model change; inside a merged interrupt-service window only the group effect is evaluable.}}{12}{figure.caption.5}\protected@file@percent }
\newlabel{fig:4}{{4}{12}{Distribution of the reversal across the frozen 14-group common attribution partition. The \textbf {whole-model observed delta is +19,000} cycles (Section~\ref {sec:7.1}); the \textbf {reconstructed profiled-group delta is +19,060}, and the \textbf {60-cycle residual} is the deterministic profiling-boundary (interrupt-service) residual described in Section~\ref {sec:9.5} --- the two measurement boundaries are not identical and the figure does not treat them as one. No group is claimed as the cause of the whole-model change; inside a merged interrupt-service window only the group effect is evaluable}{figure.caption.5}{}}
