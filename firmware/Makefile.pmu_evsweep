# PMU EV_TYPE acceptance sweep (Tier A). See
#   docs/superpowers/specs/2026-09-23-pmu-evsweep-contract.md
#
# Cloned from Makefile.pmu's build shape. Differences, all deliberate:
#   - Selftest_pmu_evsweep/ replaces Selftest_pmu/ as the main() provider.
#     Selftest_pmu/ stays on the include path for npu_pmu_regs.h ONLY; its
#     runner_pmu_main.c is never compiled here, so END_ONLY is untouched.
#   - No wrap set, no measurement denylist: this image has no measured path.
#   - Its own gate (check_pmu_evsweep.py) proves the ELF is a sweep and not a
#     runner: PMEVTYPER0 is a store target, apU85Conv_TEST is NOT linked.
#   - Build id ASCII "EVSW". No timestamp -> two clean rebuilds are identical.

TOOLCHAIN := /opt/arm/gcc-arm-none-eabi/bin/arm-none-eabi-
CC        := $(TOOLCHAIN)gcc
OBJCOPY   := $(TOOLCHAIN)objcopy
OBJDUMP   := $(TOOLCHAIN)objdump
SIZE      := $(TOOLCHAIN)size
NM        := $(TOOLCHAIN)nm
CMSIS_INC := /opt/arm/ml-embedded-evaluation-kit/dependencies/cmsis-6/CMSIS/Core/Include

BUILD    := build_pmu_evsweep
TARGET   := $(BUILD)/runner_pmu_evsweep
BUILD_ID := 0x45565357

SRCDIRS := Device_SSE-320 Drivers Selftest Selftest_cli Selftest_pmu_evsweep \
           Serial Sleep Tests
SRCS    := $(shell find $(SRCDIRS) -name '*.c' -not -name '._*')
SRCS    := $(filter-out Selftest/retarget.c Selftest/main.c Selftest/raw_rx_main.c \
                        Selftest/runner_v1_main.c,$(SRCS))
SRCS    := $(sort $(SRCS))
OBJS    := $(patsubst %.c,$(BUILD)/%.o,$(SRCS))
DEPS    := $(OBJS:.o=.d)

INCDIRS := $(sort $(dir $(shell find $(SRCDIRS) Selftest_pmu LinkScripts -name '*.h' -not -name '._*')))
INCS    := $(addprefix -I,$(INCDIRS)) -I$(CMSIS_INC)

ARCHFLAGS := -mcpu=cortex-m85+nomve+nofp -mthumb -mfloat-abi=soft
LEGACY_C  := -Wno-error=int-conversion -Wno-error=incompatible-pointer-types \
             -Wno-error=implicit-function-declaration -Wno-error=implicit-int \
             -Wno-error=return-mismatch -Wno-error=discarded-qualifiers

CFLAGS := $(ARCHFLAGS) -std=gnu11 -O1 -g3 -ffunction-sections -fdata-sections \
          -fno-builtin-printf -Wno-unused-variable -Wno-unused-function \
          -Wno-missing-braces $(LEGACY_C) \
          -DRUNNER_FIRMWARE_BUILD_ID=$(BUILD_ID) $(INCS) -MMD -MP

LDSCRIPT  := $(BUILD)/lnk.ld
LDOVERLAY := LinkScripts/lnk.measure.overlay.ld
LDFLAGS   := $(ARCHFLAGS) --specs=nano.specs --specs=nosys.specs \
             -T $(LDSCRIPT) -T $(LDOVERLAY) -Wl,-Map=$(TARGET).map,--cref \
             -Wl,--gc-sections -Wl,--print-memory-usage
LDLIBS    := -lm

VECTOR_SECTIONS := --only-section=.vectors_rom
APP_SECTIONS    := --only-section=.text --only-section=.ARM.extab \
                   --only-section=.ARM.exidx --only-section=.preinit_array \
                   --only-section=.init_array --only-section=.fini_array \
                   --only-section=.copy.table --only-section=.zero.table \
                   --only-section=.vectors_ram --only-section=.data
DDR_SECTIONS    := --only-section=.ddr

GATE := Selftest_pmu_evsweep/check_pmu_evsweep.py

.PHONY: all clean bins check hashes
all: bins check

$(LDSCRIPT): LinkScripts/lnk.ld.S LinkScripts/region_defs.h LinkScripts/region_limits.h
	@mkdir -p $(dir $@)
	$(CC) -E -P -x c -ILinkScripts $< -o $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET).elf: $(OBJS) $(LDSCRIPT) $(LDOVERLAY)
	$(CC) $(OBJS) $(LDFLAGS) -o $@ $(LDLIBS)
	$(SIZE) $@

bins: $(TARGET).elf
	$(OBJCOPY) -O binary $(VECTOR_SECTIONS) $(TARGET).elf $(BUILD)/VECTORS.BIN
	$(OBJCOPY) -O binary $(APP_SECTIONS)    $(TARGET).elf $(BUILD)/APP.BIN
	$(OBJCOPY) -O binary $(DDR_SECTIONS)    $(TARGET).elf $(BUILD)/DDR.BIN
	@ls -l $(BUILD)/VECTORS.BIN $(BUILD)/APP.BIN $(BUILD)/DDR.BIN

check: $(TARGET).elf
	$(OBJDUMP) -d $(TARGET).elf > $(TARGET).objdump
	$(NM) $(TARGET).elf > $(TARGET).nm
	python3 $(GATE) --objdump $(TARGET).objdump --nm $(TARGET).nm --build-id $(BUILD_ID)

hashes: bins
	@sha256sum $(BUILD)/APP.BIN $(BUILD)/DDR.BIN $(BUILD)/VECTORS.BIN

clean:
	rm -rf $(BUILD)

-include $(DEPS)
