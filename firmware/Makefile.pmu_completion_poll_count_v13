# Makefile.pmu_completion_poll_count_v13 -- generated-source PMU_COMPLETION_POLL_COUNT_DIAG_V13 build.

TOOLCHAIN := /opt/arm/gcc-arm-none-eabi/bin/arm-none-eabi-
CC        := $(TOOLCHAIN)gcc
OBJCOPY   := $(TOOLCHAIN)objcopy
OBJDUMP   := $(TOOLCHAIN)objdump
SIZE      := $(TOOLCHAIN)size
NM        := $(TOOLCHAIN)nm
READELF   := $(TOOLCHAIN)readelf

CMSIS_INC := /opt/arm/ml-embedded-evaluation-kit/dependencies/cmsis-6/CMSIS/Core/Include

BUILD  := build_pmu_completion_poll_count_v13
GEN    := $(BUILD)/generated
TARGET := $(BUILD)/runner_pmu_completion_poll_count_v13
BUILD_ID := 0x33314950

PATCHER := patches/patch_pmu_completion_poll_count_v13.py
GATE    := Selftest_pmu_diag/check_pmu_completion_poll_count_v13.py
RUNNER_SRC := Selftest_pmu_diag/runner_pmu_diag_main.c
VENDOR_SRC := Drivers/u85_driver/u85.c
GEN_RUNNER := $(GEN)/Selftest_pmu_diag/runner_pmu_diag_main.c
GEN_VENDOR := $(GEN)/Drivers/u85_driver/u85.c
GEN_RUNNER_OBJ := $(GEN_RUNNER:.c=.o)
GEN_VENDOR_OBJ := $(GEN_VENDOR:.c=.o)
GEN_STAMP := $(GEN)/.generated
PREPROCESSED := $(BUILD)/runner_pmu_completion_poll_count_v13_main.i
MANIFEST := $(BUILD)/pmu_completion_poll_count_v13_manifest.json
AUTHORITATIVE_V12_ELF := authoritative-v12/runner_pmu_completion_poll_v12.elf
AUTHORITATIVE_V12_SHA256 := cd44ad3e5f370833b03fb3c664da2a8cb9320e38d97786d4c2af6ec1109cf401
V12_OBJDUMP := $(BUILD)/authoritative_v12.objdump
V12_NM := $(BUILD)/authoritative_v12.nm
V13_OBJDUMP := $(BUILD)/runner_pmu_completion_poll_count_v13.objdump
V13_NM := $(BUILD)/runner_pmu_completion_poll_count_v13.nm
V13_DWARF := $(BUILD)/runner_pmu_completion_poll_count_v13.dwarf.txt
CROSS_ELF_EVIDENCE := $(BUILD)/pmu_completion_poll_count_v13_cross_elf_evidence.json
RUNNER_RECORD_WIRE_EVIDENCE := $(BUILD)/pmu_completion_poll_count_v13_runner_record_wire_evidence.json

PROFILE_CFLAGS := -DMEASUREMENT_BUILD -DPMU_DIAG_BUILD -DPMU_QUAL_SCHEMA_V8 \
                  -DPMU_QUAL_SCHEMA_V13 \
                  -DPMU_COMPLETION_POLL_COUNT_DIAG_V13 -DPMU_QUAL_MODE_Q1 \
                  -DPMU_DIAG_CASE_A -DPMU_DIAG_SEAM_S1 \
                  -DPMU_DIAG_USES_PRIVATE_DRIVER

SRCDIRS := Device_SSE-320 Drivers Selftest Selftest_cli Selftest_pmu \
           Selftest_pmu_diag Serial Sleep Tests $(GEN)/Drivers $(GEN)/Selftest_pmu_diag
SRCS    := $(shell find Device_SSE-320 Drivers Selftest Selftest_cli Selftest_pmu \
                      Selftest_pmu_diag Serial Sleep Tests -name '*.c' -not -name '._*')
SRCS := $(filter-out Selftest/retarget.c Selftest/main.c Selftest/raw_rx_main.c \
                     Selftest/runner_v1_main.c Selftest_pmu/runner_pmu_main.c \
                     Selftest_measure/runner_measure_main.c \
                     Selftest_pmu_diag/runner_pmu_diag_main.c \
                     Selftest_pmu_diag/u85_diag.c Drivers/u85_driver/u85.c,$(SRCS))
SRCS := $(sort $(SRCS))
BASE_OBJS := $(patsubst %.c,$(BUILD)/%.o,$(SRCS))
OBJS := $(BASE_OBJS) $(GEN_RUNNER_OBJ) $(GEN_VENDOR_OBJ)
DEPS := $(OBJS:.o=.d)

INCDIRS := $(sort $(dir $(shell find Device_SSE-320 Drivers Selftest Selftest_cli \
                      Selftest_pmu Selftest_pmu_diag Serial Sleep Tests LinkScripts \
                      -name '*.h' -not -name '._*')))
INCS    := $(addprefix -I,$(INCDIRS)) -I$(CMSIS_INC) -I$(GEN)

ARCHFLAGS := -mcpu=cortex-m85+nomve+nofp -mthumb -mfloat-abi=soft
LEGACY_C := -Wno-error=int-conversion \
            -Wno-error=incompatible-pointer-types \
            -Wno-error=implicit-function-declaration \
            -Wno-error=implicit-int \
            -Wno-error=return-mismatch \
            -Wno-error=discarded-qualifiers
CFLAGS := $(ARCHFLAGS) -std=gnu11 -O1 -g3 -ffunction-sections -fdata-sections \
          -fno-builtin-printf -Wno-unused-variable -Wno-unused-function \
          -Wno-missing-braces $(LEGACY_C) $(PROFILE_CFLAGS) \
          -DRUNNER_FIRMWARE_BUILD_ID=$(BUILD_ID) $(INCS) -MMD -MP
WRAP_SYMS := printf vprintf fprintf vfprintf puts putchar fwrite _write _write_r fputc serial_print
WRAPFLAGS := $(foreach s,$(WRAP_SYMS),-Wl,--wrap=$(s))
LDFLAGS   := $(ARCHFLAGS) --specs=nano.specs --specs=nosys.specs \
             -T $(BUILD)/lnk.ld -T LinkScripts/lnk.measure.overlay.ld \
             -T LinkScripts/lnk.pmu_diag.overlay.ld \
             -Wl,-Map=$(TARGET).map,--cref -Wl,--gc-sections \
             -Wl,--print-memory-usage $(WRAPFLAGS)

.PHONY: all clean bins check manifest preprocess
all: bins preprocess check manifest

$(BUILD)/lnk.ld: LinkScripts/lnk.ld.S LinkScripts/region_defs.h LinkScripts/region_limits.h
	@mkdir -p $(dir $@)
	$(CC) -E -P -x c -ILinkScripts $< -o $@

$(GEN_STAMP): $(RUNNER_SRC) $(VENDOR_SRC) $(PATCHER)
	@mkdir -p $(GEN)
	python3 $(PATCHER) \
	    --runner-in $(RUNNER_SRC) \
	    --vendor-in $(VENDOR_SRC) \
	    --runner-out $(GEN_RUNNER) \
	    --vendor-out $(GEN_VENDOR)
	@touch $@

$(GEN_RUNNER) $(GEN_VENDOR): $(GEN_STAMP)

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(GEN)/%.o: $(GEN)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET).elf: $(OBJS) $(BUILD)/lnk.ld LinkScripts/lnk.measure.overlay.ld LinkScripts/lnk.pmu_diag.overlay.ld
	$(CC) $(OBJS) $(LDFLAGS) -o $@ -lm
	$(SIZE) $@

bins: $(TARGET).elf
	$(OBJCOPY) -O binary --only-section=.vectors_rom $(TARGET).elf $(BUILD)/VECTORS.BIN
	$(OBJCOPY) -O binary --only-section=.text --only-section=.ARM.extab \
	    --only-section=.ARM.exidx --only-section=.preinit_array --only-section=.init_array \
	    --only-section=.fini_array --only-section=.copy.table --only-section=.zero.table \
	    --only-section=.vectors_ram --only-section=.data $(TARGET).elf $(BUILD)/APP.BIN
	$(OBJCOPY) -O binary --only-section=.ddr $(TARGET).elf $(BUILD)/DDR.BIN

preprocess: $(PREPROCESSED)

$(PREPROCESSED): $(GEN_RUNNER)
	$(CC) $(CFLAGS) -E $(GEN_RUNNER) -o $@

$(V12_OBJDUMP): $(AUTHORITATIVE_V12_ELF)
	@mkdir -p $(dir $@)
	$(OBJDUMP) -d $< > $@

$(V12_NM): $(AUTHORITATIVE_V12_ELF)
	@mkdir -p $(dir $@)
	$(NM) -n $< > $@

$(V13_OBJDUMP): $(TARGET).elf
	@mkdir -p $(dir $@)
	$(OBJDUMP) -d $< > $@

$(V13_NM): $(TARGET).elf
	@mkdir -p $(dir $@)
	$(NM) -n $< > $@

$(V13_DWARF): $(TARGET).elf
	@mkdir -p $(dir $@)
	$(READELF) --debug-dump=info,loc $< > $@

$(CROSS_ELF_EVIDENCE): $(TARGET).elf $(AUTHORITATIVE_V12_ELF) $(GATE) $(V12_OBJDUMP) $(V12_NM) $(V13_OBJDUMP) $(V13_NM)
	python3 -c 'import hashlib, json, pathlib, sys; \
sys.path.insert(0, "Selftest_pmu_diag"); \
import check_pmu_completion_poll_count_v13 as gate; \
v12_elf = pathlib.Path("$(AUTHORITATIVE_V12_ELF)"); \
actual = hashlib.sha256(v12_elf.read_bytes()).hexdigest(); \
expected = "$(AUTHORITATIVE_V12_SHA256)"; \
sys.exit("authoritative V12 ELF hash mismatch: %s != %s" % (actual, expected)) if actual != expected else None; \
evidence = gate.verify_cross_elf_contract(pathlib.Path("$(V12_OBJDUMP)").read_text(encoding="utf-8"), pathlib.Path("$(V12_NM)").read_text(encoding="utf-8"), pathlib.Path("$(V13_OBJDUMP)").read_text(encoding="utf-8"), pathlib.Path("$(V13_NM)").read_text(encoding="utf-8")); \
pathlib.Path("$(CROSS_ELF_EVIDENCE)").write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")'

$(RUNNER_RECORD_WIRE_EVIDENCE): $(TARGET).elf $(GEN_RUNNER) $(GATE) $(V13_OBJDUMP) $(V13_NM) $(V13_DWARF)
	python3 -c 'import json, pathlib, sys; \
sys.path.insert(0, "Selftest_pmu_diag"); \
import check_pmu_completion_poll_count_v13 as gate; \
evidence = gate.verify_runner_record_wire_contract(pathlib.Path("$(GEN_RUNNER)").read_text(encoding="utf-8"), pathlib.Path("$(V13_OBJDUMP)").read_text(encoding="utf-8"), pathlib.Path("$(V13_NM)").read_text(encoding="utf-8"), pathlib.Path("$(V13_DWARF)").read_text(encoding="utf-8")); \
pathlib.Path("$(RUNNER_RECORD_WIRE_EVIDENCE)").write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")'

check: $(CROSS_ELF_EVIDENCE) $(RUNNER_RECORD_WIRE_EVIDENCE)

manifest: $(MANIFEST)

$(MANIFEST): $(TARGET).elf $(GEN_RUNNER) $(GEN_VENDOR) $(GATE) bins $(CROSS_ELF_EVIDENCE) $(RUNNER_RECORD_WIRE_EVIDENCE) $(AUTHORITATIVE_V12_ELF) $(V12_OBJDUMP) $(V12_NM) $(V13_OBJDUMP) $(V13_NM) $(V13_DWARF)
	python3 $(GATE) \
	    --build-id $(BUILD_ID) \
	    --runner-generated $(GEN_RUNNER) \
	    --vendor-generated $(GEN_VENDOR) \
	    --elf $(TARGET).elf \
	    --authoritative-v12-elf $(AUTHORITATIVE_V12_ELF) \
	    --objdump-tool $(OBJDUMP) \
	    --nm-tool $(NM) \
	    --map $(TARGET).map \
	    --app-bin $(BUILD)/APP.BIN \
	    --vectors-bin $(BUILD)/VECTORS.BIN \
	    --ddr-bin $(BUILD)/DDR.BIN \
	    --v12-objdump $(V12_OBJDUMP) \
	    --v12-nm $(V12_NM) \
	    --v13-objdump $(V13_OBJDUMP) \
	    --v13-nm $(V13_NM) \
	    --v13-dwarf $(V13_DWARF) \
	    --readelf $(READELF) \
	    --cross-elf-evidence $(CROSS_ELF_EVIDENCE) \
	    --runner-record-wire-evidence $(RUNNER_RECORD_WIRE_EVIDENCE) \
	    --manifest-out $(MANIFEST)
	@test -s $(MANIFEST)

clean:
	rm -rf $(BUILD)

-include $(DEPS)
