# Study image: Study_conv1x1/conv1x1_main.c in place of the vendor Selftest main.
# Build shape is Makefile.gcc (same vendor sources, linker script and BIN split); only the main differs.
#   make -f Makefile.study [EVENT_SET=1|2]   -> build_study_conv1x1_e<set>/{VECTORS,APP,DDR}.BIN

TOOLCHAIN := /opt/arm/gcc-arm-none-eabi/bin/arm-none-eabi-
CC        := $(TOOLCHAIN)gcc
OBJCOPY   := $(TOOLCHAIN)objcopy
SIZE      := $(TOOLCHAIN)size
CMSIS_INC := /opt/arm/ml-embedded-evaluation-kit/dependencies/cmsis-6/CMSIS/Core/Include

EVENT_SET ?= 1
BUILD  := build_study_conv1x1_e$(EVENT_SET)
TARGET := $(BUILD)/study_conv1x1

SRCDIRS := Device_SSE-320 Drivers Selftest Selftest_cli Serial Sleep Tests Study_conv1x1
SRCS    := $(shell find $(SRCDIRS) -name '*.c' -not -name '._*')
SRCS    := $(filter-out Selftest/retarget.c Selftest/main.c Selftest/raw_rx_main.c \
                        Selftest/runner_v1_main.c,$(SRCS))
SRCS    := $(sort $(SRCS))
OBJS    := $(patsubst %.c,$(BUILD)/%.o,$(SRCS))
DEPS    := $(OBJS:.o=.d)

INCDIRS := $(sort $(dir $(shell find $(SRCDIRS) Selftest_pmu LinkScripts -name '*.h' -not -name '._*')))
INCS    := $(addprefix -I,$(INCDIRS)) -I$(CMSIS_INC)

ARCHFLAGS := -mcpu=cortex-m85+nomve+nofp -mthumb -mfloat-abi=soft
LEGACY_C  := -Wno-error=int-conversion -Wno-error=incompatible-pointer-types \
             -Wno-error=implicit-function-declaration -Wno-error=implicit-int \
             -Wno-error=return-mismatch -Wno-error=discarded-qualifiers
CFLAGS := $(ARCHFLAGS) -std=gnu11 -O1 -g3 -ffunction-sections -fdata-sections \
          -fno-builtin-printf -Wno-unused-variable -Wno-unused-function \
          -Wno-missing-braces $(LEGACY_C) -DEVENT_SET=$(EVENT_SET) $(INCS) -MMD -MP

LDSCRIPT := $(BUILD)/lnk.ld
LDFLAGS  := $(ARCHFLAGS) --specs=nano.specs --specs=nosys.specs -T $(LDSCRIPT) \
            -Wl,-Map=$(TARGET).map,--cref -Wl,--gc-sections -Wl,--print-memory-usage
LDLIBS   := -lm

VECTOR_SECTIONS := --only-section=.vectors_rom
APP_SECTIONS    := --only-section=.text --only-section=.ARM.extab --only-section=.ARM.exidx \
                   --only-section=.preinit_array --only-section=.init_array --only-section=.fini_array \
                   --only-section=.copy.table --only-section=.zero.table --only-section=.vectors_ram --only-section=.data
DDR_SECTIONS    := --only-section=.ddr

.PHONY: all clean
all: $(TARGET).elf
	$(OBJCOPY) -O binary $(VECTOR_SECTIONS) $(TARGET).elf $(BUILD)/VECTORS.BIN
	$(OBJCOPY) -O binary $(APP_SECTIONS)    $(TARGET).elf $(BUILD)/APP.BIN
	$(OBJCOPY) -O binary $(DDR_SECTIONS)    $(TARGET).elf $(BUILD)/DDR.BIN
	@ls -l $(BUILD)/VECTORS.BIN $(BUILD)/APP.BIN $(BUILD)/DDR.BIN

$(LDSCRIPT): LinkScripts/lnk.ld.S LinkScripts/region_defs.h LinkScripts/region_limits.h
	@mkdir -p $(dir $@)
	$(CC) -E -P -x c -ILinkScripts $< -o $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# the study main's own sources get -Wall -Werror; the vendor sources keep their flags
$(BUILD)/Study_conv1x1/%.o: CFLAGS += -Wall -Werror

$(TARGET).elf: $(OBJS) $(LDSCRIPT)
	$(CC) $(OBJS) $(LDFLAGS) -o $@ $(LDLIBS)
	$(SIZE) $@

clean:
	rm -rf $(BUILD)

-include $(DEPS)
